<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Assignment_ProductManager_WithoutBinding.Controls.AppPasswordBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Assignment_ProductManager_WithoutBinding.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="6">
        <TextBlock
            x:Name="LabelBlock"
            x:FieldModifier="public"
            FontSize="13"
            FontWeight="Medium"
            Foreground="{StaticResource TextPrimaryBrush}" />
        <Grid>
            <PasswordBox
                x:Name="PwdBox"
                Height="44"
                Padding="12,10"
                VerticalContentAlignment="Center"
                x:FieldModifier="public"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                CornerRadius="{StaticResource RadiusMD}"
                FontSize="14"
                GotFocus="PwdBox_GotFocus"
                LostFocus="PwdBox_LostFocus"
                PasswordChanged="PwdBox_PasswordChanged" />
        </Grid>
        <TextBlock
            x:Name="ErrorBlock"
            x:FieldModifier="public"
            FontSize="12"
            Foreground="{StaticResource BrandDangerBrush}"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
