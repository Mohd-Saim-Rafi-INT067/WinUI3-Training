<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:ConnectionId='1'
    x:Class="Assignment_ProductManager_WithoutBinding.Controls.AuthBrandPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Assignment_ProductManager_WithoutBinding.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="ThisControl"
    mc:Ignorable="d">

    <Grid Background="{StaticResource BrandPrimaryBrush}">
        <StackPanel
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
            <FontIcon x:ConnectionId='2'
                x:Name="IconElement"
                FontSize="64"
                Foreground="White" />
            <TextBlock x:ConnectionId='3'
                x:Name="HeadlineText"
                FontSize="28"
                FontWeight="Bold"
                Foreground="White"
                TextAlignment="Center" />
            <TextBlock x:ConnectionId='4'
                x:Name="SubtextText"
                FontSize="14"
                Foreground="#BFDBFE"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>

