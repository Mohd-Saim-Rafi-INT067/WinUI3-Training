<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Assignment_ProductManager_WithoutBinding.Controls.AppButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Assignment_ProductManager_WithoutBinding.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Button x:ConnectionId='2'
        x:Name="RootButton"
        Height="44"
        Padding="20,0"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Center"
        x:FieldModifier="public"
                                
        CornerRadius="{StaticResource RadiusMD}">
        <Button.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1E40AF " />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1E40AF " />
        </Button.Resources>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon x:ConnectionId='3'
                x:Name="IconElement"
                VerticalAlignment="Center"
                x:FieldModifier="public"
                FontSize="14"
                Glyph=""
                Visibility="Collapsed" />
            <ProgressRing x:ConnectionId='4'
                x:Name="LoadingRing"
                Width="16"
                Height="16"
                x:FieldModifier="public"
                Foreground="Black"
                IsActive="False"
                Visibility="Collapsed" />
            <TextBlock x:ConnectionId='5'
                x:Name="LabelText"
                VerticalAlignment="Center"
                x:FieldModifier="public"
                FontSize="{StaticResource FontSizeMD}"
                FontWeight="SemiBold" />
        </StackPanel>
    </Button>
</UserControl>

