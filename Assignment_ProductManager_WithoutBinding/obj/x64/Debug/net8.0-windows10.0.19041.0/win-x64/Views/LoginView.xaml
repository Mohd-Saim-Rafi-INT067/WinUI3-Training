<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Assignment_ProductManager_WithoutBinding.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Assignment_ProductManager_WithoutBinding.Controls"
    xmlns:converters="using:Assignment_ProductManager_WithoutBinding.Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Assignment_ProductManager_WithoutBinding.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="800" />
        </Grid.ColumnDefinitions>

        <!--  Left brand panel  -->
        <controls:AuthBrandPanel
            Grid.Column="0"
            Headline="Smart Product Manager"
            IconGlyph="&#xE716;"
            Subtext="Manage your inventory with ease." />


        <!--  Login card  -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel
                Padding="48,60"
                VerticalAlignment="Center"
                Spacing="24">

                <!--  Header  -->
                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="{StaticResource FontSize3XL}"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Welcome Back!" />
                    <TextBlock
                        FontSize="{StaticResource FontSizeMD}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Sign in to your account" />
                </StackPanel>

                <!--  Error banner  -->
                <controls:AlertBanner x:ConnectionId='2' x:Name="ErrorBanner" Type="Error" />

                <!--  username  -->
                <controls:AppTextBox x:ConnectionId='3'
                    x:Name="UsernameBox"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Label="Username"
                    Placeholder="Enter your username" />

                <controls:AppPasswordBox x:ConnectionId='4'
                    x:Name="PasswordBox"
                    VerticalAlignment="Center"
                    Label="Password"
                    Placeholder="Enter your password" />

                <!--  Login button  -->
                <controls:AppButton x:ConnectionId='5'
                    x:Name="LoginBtn"
                    IconGlyph="&#xE8EC;"
                    Label="Sign In" />

                <!--  Divider  -->
                <controls:AuthDivider />

                <!--  Sign up redirect  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Don't have an account?" />

                    <HyperlinkButton x:ConnectionId='6'
                        x:Name="GoToSignUpBtn"
                        Margin="6,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Content="Create Account"
                        FontSize="14" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

