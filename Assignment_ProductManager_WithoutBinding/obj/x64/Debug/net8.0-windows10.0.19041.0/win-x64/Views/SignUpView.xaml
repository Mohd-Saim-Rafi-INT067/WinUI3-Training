<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Assignment_ProductManager_WithoutBinding.Views.SignUpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Assignment_ProductManager_WithoutBinding.Controls"
    xmlns:converters="using:Assignment_ProductManager_WithoutBinding.Core.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Assignment_ProductManager_WithoutBinding.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="800" />
        </Grid.ColumnDefinitions>

        <controls:AuthBrandPanel
            Grid.Column="0"
            Headline="Join Us Today"
            IconGlyph="&#xE8FA;"
            Subtext="Manage your inventory with ease with Smart Product Manager." />

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="48,48" Spacing="20">

                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="{StaticResource FontSize3XL}"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Create Account" />
                    <TextBlock
                        FontSize="{StaticResource FontSizeMD}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Fill in the details below to get started" />
                </StackPanel>

                <!--  Error / Success banners  -->
                <controls:AlertBanner x:ConnectionId='2' x:Name="ErrorBanner" Type="Error" />

                <controls:AlertBanner x:ConnectionId='3' x:Name="SuccessBanner" Type="Success" />

                <!--  Two columns for name + username  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <controls:AppTextBox x:ConnectionId='10'
                        x:Name="FullNameBox"
                        Grid.Column="0"
                        Label="Full Name"
                        Placeholder="John Doe" />
                    <controls:AppTextBox x:ConnectionId='11'
                        x:Name="UsernameBox"
                        Grid.Column="1"
                        Label="Username"
                        Placeholder="johndoe123" />
                </Grid>

                <controls:AppTextBox x:ConnectionId='4'
                    x:Name="EmailBox"
                    Label="Email Address"
                    Placeholder="john@example.com" />

                <controls:AppTextBox x:ConnectionId='5'
                    x:Name="PhoneBox"
                    Label="Phone Number (Optional)"
                    Placeholder="+91 99999 00000" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <controls:AppPasswordBox x:ConnectionId='8'
                        x:Name="PasswordBox"
                        Grid.Column="0"
                        Label="Password"
                        Placeholder="Min. 6 characters" />
                    <controls:AppPasswordBox x:ConnectionId='9'
                        x:Name="ConfirmPasswordBox"
                        Grid.Column="1"
                        Label="Confirm Password"
                        Placeholder="Re-enter password" />
                </Grid>

                <controls:AppButton x:ConnectionId='6'
                    x:Name="RegisterBtn"
                    IconGlyph="&#xE8FA;"
                    Label="Create Account" />

                <controls:AuthDivider />

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Already have an account?" />

                    <HyperlinkButton x:ConnectionId='7'
                        x:Name="GoToLoginBtn"
                        Margin="6,0,0,0"
                        Padding="0"
                        VerticalAlignment="Center"
                        Content="Sign In"
                        FontSize="14" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

