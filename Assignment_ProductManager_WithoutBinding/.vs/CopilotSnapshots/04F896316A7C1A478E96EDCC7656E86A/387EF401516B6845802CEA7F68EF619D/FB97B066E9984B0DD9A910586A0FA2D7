namespace Assignment_Product_Manager
{
    /// <summary>
    /// Provides application-specific behavior to supplement the default Application class.
    /// </summary>
    public partial class App : Application
    {
        public static IServiceProvider Services { get; private set; } = null!;
        public static Window MainWindow { get; private set; } = null!;

        public App()
        {
            this.InitializeComponent();

            // Global exception handlers to capture crashes and log details.
            this.UnhandledException += App_UnhandledException;
            AppDomain.CurrentDomain.UnhandledException += CurrentDomain_UnhandledException;
            TaskScheduler.UnobservedTaskException += TaskScheduler_UnobservedTaskException;
        }

        protected override async void OnLaunched(LaunchActivatedEventArgs args)
        {
            IConfiguration config;

            try
            {
                var file = await StorageFile.GetFileFromApplicationUriAsync(
                    new Uri("ms-appx:///appsettings.json"));

                using var stream = await file.OpenStreamForReadAsync();

                config = new ConfigurationBuilder()
                    .AddJsonStream(stream)
                    .Build();
            }
            catch (Exception ex)
            {
                System.Diagnostics.Debug.WriteLine("CONFIG ERROR: " + ex);
                throw;
            }

            var services = new ServiceCollection();
            RegisterServices(services, config);
            Services = services.BuildServiceProvider();

            MainWindow = new Window();
            var frame = new Frame();
            MainWindow.Content = frame;

            // Try safe minimal startup first to isolate issue
            try
            {
                frame.Navigate(typeof(SafeStartupView));
            }
            catch (Exception ex)
            {
                Debug.WriteLine("NAVIGATION ERROR: " + ex);
                // If navigation to safe view fails, rethrow to ensure global handlers capture
                throw;
            }

            MainWindow.Activate();
        }

        private static void RegisterServices(IServiceCollection services, IConfiguration config)
        {
            // Configuration
            services.AddSingleton<IConfiguration>(config);

            // Database
            services.AddSingleton<DbConnectionFactory>();

            // Repositories
            services.AddScoped<IUserRepository, UserRepository>();
            services.AddScoped<IProductRepository, ProductRepository>();

            // Services
            services.AddScoped<IAuthService, AuthService>();
            services.AddScoped<IProductService, ProductService>();

            // ViewModels
            services.AddTransient<LoginViewModel>();
            services.AddTransient<SignUpViewModel>();
            services.AddTransient<DashboardViewModel>();
            services.AddTransient<AddEditProductViewModel>();
        }

        // Helper to resolve services from anywhere
        public static T GetService<T>() where T : class
            => Services.GetRequiredService<T>();

        private void App_UnhandledException(object sender, Microsoft.UI.Xaml.UnhandledExceptionEventArgs e)
        {
            // Log and prevent the app from crashing immediately so we can capture details
            Debug.WriteLine("UNHANDLED UI EXCEPTION: " + e.Exception.ToString());

            try
            {
                // Try to show a simple dialog to the user with the message (best effort)
                var dialog = new Microsoft.UI.Xaml.Controls.ContentDialog
                {
                    Title = "Unhandled Exception",
                    Content = e.Exception.Message,
                    CloseButtonText = "OK"
                };

                // Show dialog on UI thread if possible (fire-and-forget)
                if (MainWindow != null && MainWindow.DispatcherQueue != null)
                {
                    MainWindow.DispatcherQueue.TryEnqueue(async () => await dialog.ShowAsync());
                }
            }
            catch
            {
                // ignore errors from showing the dialog
            }

            // Mark handled to avoid immediate termination; still log so you can inspect
            e.Handled = true;
        }

        private void CurrentDomain_UnhandledException(object sender,System.UnhandledExceptionEventArgs e)
        {
            Debug.WriteLine("UNHANDLED DOMAIN EXCEPTION: " + (e.ExceptionObject?.ToString() ?? "(null)"));
        }

        private void TaskScheduler_UnobservedTaskException(object? sender, UnobservedTaskExceptionEventArgs e)
        {
            Debug.WriteLine("UNOBSERVED TASK EXCEPTION: " + e.Exception.ToString());
            e.SetObserved();
        }
    }
}
