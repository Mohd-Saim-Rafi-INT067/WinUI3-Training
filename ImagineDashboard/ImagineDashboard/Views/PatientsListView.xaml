<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ImagineDashboard.Views.PatientsListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <Grid RowDefinitions="Auto,*">

        <!--  Tab Header Row  -->
        <Grid
            Grid.Row="0"
            Background="{ThemeResource SolidBackgroundFillColorBase}"
            BorderBrush="{ThemeResource DividerStrokeColorDefault}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="0">
                <Border
                    x:Name="TabPatients"
                    Padding="16,8"
                    Background="Transparent"
                    BorderBrush="#0078D4"
                    BorderThickness="0,0,0,2">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#0078D4"
                        Text="Patients" />
                </Border>
                <Border Padding="16,8" Background="Transparent">
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondary}"
                        Text="Patient Information" />
                </Border>
                <Border Padding="16,8" Background="Transparent">
                    <TextBlock
                        FontSize="13"
                        Foreground="{ThemeResource TextFillColorSecondary}"
                        Text="Insurance Information" />
                </Border>
            </StackPanel>

            <!--  Filter + Gear icons  -->
            <StackPanel
                Grid.Column="1"
                Margin="0,0,8,0"
                Orientation="Horizontal"
                Spacing="4">
                <!--  filter button  -->
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0">
                    <FontIcon FontSize="14" Glyph="&#xE71C;" />
                </Button>
                <!--  Settings button  -->
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0">
                    <FontIcon FontSize="14" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  DataGrid  -->
        <controls:DataGrid
            x:Name="PatientsDataGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            GridLinesVisibility="All"
            ItemsSource="{x:Bind ViewModel.Patients, Mode=OneWay}"
            RowHeight="36"
            SelectionChanged="PatientsDataGrid_SelectionChanged"
            SelectionMode="Single">

            <controls:DataGrid.Columns>
                <controls:DataGridTextColumn
                    Width="100"
                    Binding="{Binding Audited}"
                    Header="Audited" />
                <controls:DataGridTextColumn
                    Width="100"
                    Binding="{Binding Pos}"
                    Header="POS" />
                <controls:DataGridTextColumn
                    Width="100"
                    Binding="{Binding PatientId}"
                    Header="Patient ID" />
                <controls:DataGridTextColumn
                    Width="*"
                    Binding="{Binding FirstName}"
                    Header="First Name" />
                <controls:DataGridTextColumn
                    Width="*"
                    Binding="{Binding MiddleName}"
                    Header="Middle Name" />
            </controls:DataGrid.Columns>
        </controls:DataGrid>
    </Grid>
</UserControl>