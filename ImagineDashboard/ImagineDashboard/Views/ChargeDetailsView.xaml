<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ImagineDashboard.Views.ChargeDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ImagineDashboard.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">

    <Grid>
        <Border
            Background="{ThemeResource SolidBackgroundFillColorBase}"
            BorderBrush="{ThemeResource DividerStrokeColorDefault}"
            BorderThickness="0,1,0,0"
            Canvas.ZIndex="10">

            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                <Grid
                    Grid.Row="0"
                    Padding="8,4"
                    Background="{ThemeResource SolidBackgroundFillColorSecondary}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefault}"
                    BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Height="25"
                            MinWidth="50"
                            Background="#dbdbdb"
                            BorderThickness="0"
                            Content="Autofill"
                            CornerRadius="10"
                            FontSize="12"
                            Foreground="Black" />
                        <Border
                            Padding="12,4"
                            BorderBrush="#0078D4"
                            BorderThickness="0,0,0,2">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#0078D4"
                                Text="Charge Details" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!--  Validation error row here starts  -->

                <Border
                    Grid.Row="1"
                    Padding="8,4"
                    Background="White"
                    BorderBrush="#e87c2a"
                    BorderThickness="0,0,0,0"
                    Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="Red"
                                Text="!" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="Red"
                                Text="Validation Failed" />
                        </StackPanel>
                        <TextBlock
                            FontSize="11"
                            Foreground="Red"
                            Text="{Binding ValidationMessage}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Proc Code, dateOfService, DoctorId, Doctor Name, Ref Doctor ID, Doctor Name, Doctor2 ID, Doctor Name, Other Doctor ID, Doctor Name, Claim 19 Code, Procedure  -->

                <Grid
                    Grid.Row="2"
                    Padding="8,6"
                    ColumnDefinitions="90,120,90,120,90,120,90,120,95,120,85,80"
                    ColumnSpacing="6">


                    <controls:CustomSearchTextInput
                        Grid.Column="0"
                        IsHighlighted="{Binding IsProcedureEmpty}"
                        Label="Proc Code*"
                        PlaceholderText=""
                        Text="{Binding CurrentPatientDetails.Procedure, Mode=TwoWay}" />

                    <controls:CustomDateInput
                        Grid.Column="1"
                        Date="{Binding FromDate, Mode=TwoWay}"
                        Label="Date Of Service" />

                    <controls:CustomSearchTextInput
                        Grid.Column="2"
                        Label="Doctor ID*"
                        PlaceholderText=""
                        Text="{Binding CurrentPatientDetails.PatientId, Mode=TwoWay}" />

                    <controls:CustomTextInput Grid.Column="3" Label="Doctor Name " />

                    <controls:CustomSearchTextInput
                        Grid.Column="4"
                        IsHighlighted="{Binding IsOrderNumberEmpty}"
                        Label="Ref Doc ID*"
                        PlaceholderText=""
                        Text="{Binding CurrentPatientDetails.OrderNumber, Mode=TwoWay}" />

                    <controls:CustomTextInput Grid.Column="5" Label="Doctor Name" />

                    <controls:CustomSearchTextInput
                        Grid.Column="6"
                        Label="Doctor2 ID*"
                        PlaceholderText=""
                        Text="{Binding CurrentPatientDetails.VisitNumber, Mode=TwoWay}" />

                    <controls:CustomTextInput Grid.Column="7" Label="Doctor Name" />

                    <controls:CustomSearchTextInput
                        Grid.Column="8"
                        Label="Other Doctor ID"
                        PlaceholderText=""
                        Text="{Binding CurrentPatientDetails.PatientId, Mode=TwoWay}" />

                    <controls:CustomTextInput Grid.Column="9" Label="Doctor Name" />
                    <controls:CustomTextInput Grid.Column="10" Label="Claim 19 Note" />
                    <controls:CustomTextInput Grid.Column="11" Label="Procedure" />
                </Grid>

                <!--  Visit number, Modifier, Order Number, Dept Code, Units, ICD10, POA  -->
                <Grid
                    Grid.Row="3"
                    Padding="8,0,8,6"
                    ColumnDefinitions="100,80,110,80,80,*,80"
                    ColumnSpacing="8">

                    <controls:CustomTextInput Grid.Column="0" Label="Visit Number" />
                    <controls:CustomTextInput Grid.Column="1" Label="Modifier" />
                    <controls:CustomTextInput Grid.Column="2" Label="Order Number" />

                    <controls:CustomSearchTextInput
                        Grid.Column="3"
                        Label="Dept Code"
                        PlaceholderText=""
                        Text="{Binding SearchText, Mode=TwoWay}" />
                    <controls:CustomTextInput
                        Grid.Column="4"
                        IsHighlighted="{Binding IsUnitsEmpty}"
                        Label="Units"
                        Text="{Binding CurrentPatientDetails.Units, Mode=TwoWay}" />

                    <controls:CustomTextInput Grid.Column="5" Label="ICD10" />

                    <Button
                        Grid.Column="6"
                        Height="25"
                        MinWidth="50"
                        Background="#dbdbdb"
                        BorderThickness="0"
                        Content="POA"
                        CornerRadius="10"
                        FontSize="10"
                        Foreground="Black" />
                </Grid>

                <!--  Primary Authorization, Units of Measure, NDC Units, Update NDC, Interpretation Date, Id, Interpreation location  -->
                <Grid
                    Grid.Row="4"
                    Padding="8,0,8,6"
                    ColumnDefinitions="140,100,80,Auto,120,80,*"
                    ColumnSpacing="8">
                    <controls:CustomTextInput Grid.Column="0" Label="Primary Authorization" />
                    <controls:CustomTextInput Grid.Column="1" Label="Units Of Measure" />
                    <controls:CustomTextInput Grid.Column="2" Label="NDC Units" />
                    <Button
                        Grid.Column="3"
                        Height="25"
                        MinWidth="50"
                        Background="#dbdbdb"
                        BorderThickness="0"
                        Content="Update NDC"
                        CornerRadius="10"
                        FontSize="10"
                        Foreground="Black" />
                    <controls:CustomDateInput
                        Grid.Column="4"
                        Date="{Binding FromDate, Mode=TwoWay}"
                        Label="Interpretation Date" />
                    <controls:CustomSearchTextInput
                        x:Name="SearchInput"
                        Grid.Column="5"
                        GettingFocus="SearchInput_GettingFocus"
                        Label="ID"
                        LostFocus="SearchInput_LostFocus"
                        PlaceholderText=""
                        PointerPressed="SearchInput_PointerPressed"
                        Text="{Binding SearchText, Mode=TwoWay}" />

                    <controls:CustomTextInput Grid.Column="6" Label="Interpretation Location" />
                </Grid>

                <Grid
                    Grid.Row="5"
                    Padding="8,4"
                    Background="{ThemeResource SolidBackgroundFillColorSecondary}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefault}"
                    BorderThickness="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="4">

                        <SplitButton
                            Height="25"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Background="#dbdbdb"
                            CornerRadius="10"
                            FontSize="12"
                            Foreground="Black">
                            <SplitButton.Content>
                                <TextBlock Text="Action" />
                            </SplitButton.Content>
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Move To Bucket" />
                                    <MenuFlyoutItem Text="Send To Fast Review" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutSubItem Text="Follow Up Letter">
                                        <MenuFlyoutItem Text="Standard Letter" />
                                        <MenuFlyoutItem Text="Custom Letter" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Disable Post On Hold" />
                                    <MenuFlyoutItem Text="View Hold Note" />
                                    <MenuFlyoutItem Text="Enable Hold in Charge Central" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="View Charge Amount" />
                                    <MenuFlyoutSubItem Text="Override Charge Amount">
                                        <MenuFlyoutItem Text="Override with $9.00" />
                                        <MenuFlyoutItem Text="Enter Custom Amount" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="View Payment Summary" />
                                    <MenuFlyoutSubItem Text="Place Of Service">
                                        <MenuFlyoutItem Text="OP – Outpatient" />
                                        <MenuFlyoutItem Text="ER – Emergency" />
                                        <MenuFlyoutItem Text="IP – Inpatient" />
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete" />
                                    <MenuFlyoutItem Text="Move Charges to Visit" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <Button
                            Height="25"
                            MinWidth="50"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            Background="#dbdbdb"
                            BorderThickness="0"
                            Content="LCD Check"
                            CornerRadius="10"
                            Foreground="Black" />

                        <SplitButton
                            Height="25"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Background="#dbdbdb"
                            CornerRadius="10"
                            FontSize="12"
                            Foreground="Black">
                            <SplitButton.Content>
                                <TextBlock Text="Release" />
                            </SplitButton.Content>
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Release to Billing" />
                                    <MenuFlyoutItem Text="Release and Hold" />
                                    <MenuFlyoutItem Text="Force Release" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <Button
                            Height="25"
                            MinWidth="50"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            Background="#dbdbdb"
                            BorderThickness="0"
                            Content="Eligibility"
                            CornerRadius="10"
                            Foreground="Black" />
                    </StackPanel>

                    <!--  Charge Audits, Notes, Patients, ...  -->
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4">

                        <Button
                            Height="25"
                            MinWidth="50"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            Background="#dbdbdb"
                            BorderThickness="0"
                            Content="Charge Audit"
                            CornerRadius="10"
                            Foreground="Black" />

                        <SplitButton
                            Height="25"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Background="#dbdbdb"
                            CornerRadius="10"
                            FontSize="12"
                            Foreground="Black">
                            <SplitButton.Content>
                                <TextBlock Text="Notes" />
                            </SplitButton.Content>
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Add Note" />
                                    <MenuFlyoutItem Text="View All Notes" />
                                    <MenuFlyoutItem Text="Clinical Notes" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <SplitButton
                            Height="25"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Background="#dbdbdb"
                            CornerRadius="10"
                            FontSize="12"
                            Foreground="Black">
                            <SplitButton.Content>
                                <TextBlock Text="Patient" />
                            </SplitButton.Content>
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Patient Demographics" />
                                    <MenuFlyoutItem Text="Patient History" />
                                    <MenuFlyoutItem Text="Insurance Information" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <Button
                            Height="25"
                            MinWidth="50"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            Background="#67bed9"
                            BorderThickness="0"
                            Content="Fast Review"
                            CornerRadius="10"
                            Foreground="White" />

                        <SplitButton
                            Height="25"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Background="#67bed9"
                            CornerRadius="10"
                            FontSize="12"
                            Foreground="White">
                            <SplitButton.Content>
                                <TextBlock Text="Options" />
                            </SplitButton.Content>
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Print Charge" />
                                    <MenuFlyoutItem Text="Export to PDF" />
                                    <MenuFlyoutItem Text="Charge Settings" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>

                        <Button
                            Height="25"
                            MinWidth="50"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            Background="#67bed9"
                            BorderThickness="0"
                            Content="Close"
                            CornerRadius="10"
                            Foreground="White" />
                    </StackPanel>
                </Grid>

            </Grid>
        </Border>
        <TeachingTip
            x:Name="Tip"
            Grid.RowSpan="6"
            Canvas.ZIndex="100"
            CloseButtonContent="Ok"
            CloseButtonStyle="{StaticResource AccentButtonStyle}"
            IsLightDismissEnabled="True"
            PreferredPlacement="Top"
            Subtitle="Interpretation Location ID does not exists"
            Target="{x:Bind SearchInput}" />
    </Grid>
</UserControl>