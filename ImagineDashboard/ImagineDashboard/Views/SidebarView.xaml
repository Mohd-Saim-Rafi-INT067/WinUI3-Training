<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ImagineDashboard.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ImagineDashboard.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="white">
            <StackPanel Orientation="Vertical" Spacing="0">

                <Border
                    Height="48"
                    Margin="0,0,0,4"
                    Background="#E3F2FD">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#1565C0"
                        Text="Imagine" />
                </Border>

                <local:SidebarNavItem
                    Command="{x:Bind ViewModel.NavigateToPageCommand}"
                    CommandParameter="home"
                    Icon="&#xE80F;"
                    Label="Home"
                    Tag="home" />
                <local:SidebarNavItem
                    Command="{x:Bind ViewModel.NavigateToPageCommand}"
                    CommandParameter="charge"
                    Icon="&#xE8A5;"
                    Label="Charge"
                    Tag="charge" />
                <local:SidebarNavItem
                    Command="{x:Bind ViewModel.NavigateToPageCommand}"
                    CommandParameter="billing"
                    Icon="&#xE7C3;"
                    Label="Billing"
                    Tag="billing" />
                <local:SidebarNavItem
                    Command="{x:Bind ViewModel.NavigateToPageCommand}"
                    CommandParameter="patient"
                    Icon="&#xE716;"
                    Label="Patient"
                    Tag="patient" />
                <local:SidebarNavItem
                    Command="{x:Bind ViewModel.NavigateToPageCommand}"
                    CommandParameter="payment"
                    Icon="&#xE8C7;"
                    Label="Payment"
                    Tag="payment" />
                <local:SidebarNavItem
                    Command="{x:Bind ViewModel.NavigateToPageCommand}"
                    CommandParameter="followup"
                    Icon="&#xE7C5;"
                    Label="Follow Up"
                    Tag="followup" />
                <local:SidebarNavItem
                    Command="{x:Bind ViewModel.NavigateToPageCommand}"
                    CommandParameter="contract"
                    Icon="&#xE8D7;"
                    Label="Contract"
                    Tag="contract" />
                <local:SidebarNavItem
                    Command="{x:Bind ViewModel.NavigateToPageCommand}"
                    CommandParameter="copilot"
                    Icon="&#xE8BE;"
                    Label="Imagine&#x0A;Co-Pilot"
                    Tag="copilot" />
                <local:SidebarNavItem
                    Command="{x:Bind ViewModel.NavigateToPageCommand}"
                    CommandParameter="system"
                    Icon="&#xE713;"
                    Label="System"
                    Tag="system" />
            </StackPanel>
        </Border>

        <!--  ContentPresenter now receives actual UserControl objects, not ViewModels  -->
        <ContentPresenter Grid.Column="1" Content="{x:Bind ViewModel.CurrentView, Mode=OneWay}" />
    </Grid>
</UserControl>