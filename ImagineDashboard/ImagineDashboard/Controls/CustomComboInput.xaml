<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ImagineDashboard.Controls.CustomComboInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!--  Outlined border that wraps the ComboBox  -->
        <Border
            Height="28"
            Margin="0,8,0,0"
            BorderBrush="#c3c8c9"
            BorderThickness="1"
            CornerRadius="10">
            <ComboBox
                x:Name="InnerComboBox"
                Padding="8,2"
                HorizontalAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                FontSize="12"
                SelectionChanged="InnerComboBox_SelectionChanged" />
        </Border>

        <!--  Floating label — sits on top of the border line  -->
        <Border
            Margin="10,2,0,0"
            Padding="4,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <TextBlock
                x:Name="LabelText"
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="#1565C0"
                Text="{x:Bind Label, Mode=OneWay}" />
        </Border>
    </Grid>
</UserControl>