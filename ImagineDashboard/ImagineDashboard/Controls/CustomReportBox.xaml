<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="ImagineDashboard.Controls.CustomReportBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!--  Main border container  -->
        <Border
            x:Name="OuterBorder"
            Padding="{x:Bind Padding, Mode=OneWay}"
            Background="{x:Bind Background, Mode=OneWay}"
            BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
            BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
            CornerRadius="{x:Bind CornerRadius, Mode=OneWay}">

            <ContentPresenter Content="{x:Bind Content, Mode=OneWay}" ContentTemplate="{x:Bind ContentTemplate, Mode=OneWay}" />
        </Border>

        <!--  Floating header sitting on the border line  -->
        <Border
            Margin="12,-8,0,0"
            Padding="6,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{x:Bind HeaderBackground, Mode=OneWay}">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{x:Bind HeaderForeground, Mode=OneWay}"
                Text="{x:Bind Header, Mode=OneWay}" />
        </Border>
    </Grid>
</UserControl>