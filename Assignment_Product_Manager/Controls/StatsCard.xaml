<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Assignment_Product_Manager.Controls.StatsCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Assignment_Product_Manager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Padding="20"
        Background="{StaticResource CardBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource RadiusLG}">
        <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Border
                    x:Name="IconBorder"
                    Width="40"
                    Height="40"
                    CornerRadius="{StaticResource RadiusMD}">
                    <FontIcon
                        x:Name="IconElement"
                        FontSize="18" />
                </Border>
                <TextBlock
                    x:Name="LabelText"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <TextBlock
                x:Name="ValueText"
                FontSize="{StaticResource FontSize3XL}"
                FontWeight="Bold"
                Foreground="{StaticResource TextPrimaryBrush}" />
        </StackPanel>
    </Border>
</UserControl>
