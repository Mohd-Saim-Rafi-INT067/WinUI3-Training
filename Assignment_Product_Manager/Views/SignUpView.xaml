<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Assignment_Product_Manager.Views.SignUpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Assignment_Product_Manager.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:converters="using:Assignment_Product_Manager.Core.Converters"
    xmlns:controls="using:Assignment_Product_Manager.Controls">
    

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="800" />
        </Grid.ColumnDefinitions>

        <controls:AuthBrandPanel
            Grid.Column="0"
            IconGlyph="&#xE8FA;"
            Headline="Join Us Today"
            Subtext="Manage your inventory with ease with Smart Product Manager.">
        </controls:AuthBrandPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="48,48" Spacing="20">

                <StackPanel Spacing="6">
                    <TextBlock
                    FontSize="{StaticResource FontSize3XL}"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Create Account" />
                    <TextBlock
                    FontSize="{StaticResource FontSizeMD}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Fill in the details below to get started" />
                </StackPanel>

                <!--  Error / Success banners  -->
                <controls:AlertBanner
                    Type="Error"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

                <controls:AlertBanner
                    Type="Success"
                    Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" />

                <!--  Two columns for name + username  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <controls:AppTextBox
                    Grid.Column="0"
                    Label="Full Name"
                    Placeholder="John Doe"
                    Text="{x:Bind ViewModel.FullName, Mode=TwoWay}" />
                    <controls:AppTextBox
                    Grid.Column="1"
                    Label="Username"
                    Placeholder="johndoe123"
                    Text="{x:Bind ViewModel.Username, Mode=TwoWay}" />
                </Grid>

                <controls:AppTextBox
                Label="Email Address"
                Placeholder="john@example.com"
                Text="{x:Bind ViewModel.Email, Mode=TwoWay}" />

                <controls:AppTextBox
                Label="Phone Number (Optional)"
                Placeholder="+91 99999 00000"
                Text="{x:Bind ViewModel.PhoneNumber, Mode=TwoWay}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <controls:AppPasswordBox
                    Grid.Column="0"
                    Label="Password"
                    Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                    Placeholder="Min. 6 characters" />
                    <controls:AppPasswordBox
                    Grid.Column="1"
                    Label="Confirm Password"
                    Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay}"
                    Placeholder="Re-enter password" />
                </Grid>

                <controls:AppButton
                Command="{x:Bind ViewModel.RegisterCommand}"
                IconGlyph="&#xE8FA;"
                IsLoading="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Label="Create Account" />

                <controls:AuthDivider />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock
                    FontSize="16"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Already have an account?"
                    VerticalAlignment="Center"/>

                    <HyperlinkButton
                     Content="Sign In"
                     Command="{x:Bind ViewModel.GoToLoginCommand}"
                     Padding="0"
                     Margin="6,0,0,0"
                     FontSize="14"
                     VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
