<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Assignment_Product_Manager.Views.SignUpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Assignment_Product_Manager.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:converters="using:Assignment_Product_Manager.Core.Converters"
    xmlns:controls="using:Assignment_Product_Manager.Controls">
    

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="800" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource BrandPrimaryBrush}">
            <StackPanel
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="20">
                <FontIcon
                FontSize="64"
                Foreground="White"
                Glyph="&#xE8FA;" />
                <TextBlock
                FontSize="26"
                FontWeight="Bold"
                Foreground="White"
                Text="Join Us Today"
                TextAlignment="Center" />
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon
                        FontSize="14"
                        Foreground="#86EFAC"
                        Glyph="&#xE73E;" />
                        <TextBlock
                        FontSize="13"
                        Foreground="#BFDBFE"
                        Text="Manage your own products" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon
                        FontSize="14"
                        Foreground="#86EFAC"
                        Glyph="&#xE73E;" />
                        <TextBlock
                        FontSize="13"
                        Foreground="#BFDBFE"
                        Text="Auto discount calculation" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon
                        FontSize="14"
                        Foreground="#86EFAC"
                        Glyph="&#xE73E;" />
                        <TextBlock
                        FontSize="13"
                        Foreground="#BFDBFE"
                        Text="Realtime inventory tracking" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="48,48" Spacing="20">

                <StackPanel Spacing="6">
                    <TextBlock
                    FontSize="{StaticResource FontSize3XL}"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Create Account" />
                    <TextBlock
                    FontSize="{StaticResource FontSizeMD}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Fill in the details below to get started" />
                </StackPanel>

                <!--  Error / Success banners  -->
                <Border
                Padding="14,10"
                Background="#FEF2F2"
                BorderBrush="#FECACA"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMD}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Converter={StaticResource NullToVis}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                        FontSize="14"
                        Foreground="{StaticResource BrandDangerBrush}"
                        Glyph="&#xE783;" />
                        <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource BrandDangerBrush}"
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                Padding="14,10"
                Background="#F0FDF4"
                BorderBrush="#BBF7D0"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMD}"
                Visibility="{x:Bind ViewModel.SuccessMessage, Converter={StaticResource NullToVis}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                        FontSize="14"
                        Foreground="{StaticResource BrandSuccessBrush}"
                        Glyph="&#xE73E;" />
                        <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource BrandSuccessBrush}"
                        Text="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <!--  Two columns for name + username  -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <controls:AppTextBox
                    Grid.Column="0"
                    Label="Full Name"
                    Placeholder="John Doe"
                    Text="{x:Bind ViewModel.FullName, Mode=TwoWay}" />
                    <controls:AppTextBox
                    Grid.Column="1"
                    Label="Username"
                    Placeholder="johndoe123"
                    Text="{x:Bind ViewModel.Username, Mode=TwoWay}" />
                </Grid>

                <controls:AppTextBox
                Label="Email Address"
                Placeholder="john@example.com"
                Text="{x:Bind ViewModel.Email, Mode=TwoWay}" />

                <controls:AppTextBox
                Label="Phone Number (Optional)"
                Placeholder="+91 99999 00000"
                Text="{x:Bind ViewModel.PhoneNumber, Mode=TwoWay}" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <controls:AppPasswordBox
                    Grid.Column="0"
                    Label="Password"
                    Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                    Placeholder="Min. 6 characters" />
                    <controls:AppPasswordBox
                    Grid.Column="1"
                    Label="Confirm Password"
                    Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay}"
                    Placeholder="Re-enter password" />
                </Grid>

                <controls:AppButton
                Command="{x:Bind ViewModel.RegisterCommand}"
                IconGlyph="&#xE8FA;"
                IsLoading="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Label="Create Account" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock
                    FontSize="16"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Already have an account?"
                    VerticalAlignment="Center"/>

                    <HyperlinkButton
                     Content="Sign In"
                     Command="{x:Bind ViewModel.GoToLoginCommand}"
                     Padding="0"
                     Margin="6,0,0,0"
                     FontSize="14"
                     VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
