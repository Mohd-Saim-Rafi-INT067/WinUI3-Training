<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Assignment_Product_Manager.Views.AddEditProductView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Assignment_Product_Manager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Assignment_Product_Manager.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        Padding="32,24"
        HorizontalAlignment="Center"
        VerticalScrollBarVisibility="Hidden">
        <StackPanel MaxWidth="900" Spacing="24">

            <!--  Header  -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    Width="36"
                    Height="36"
                    Padding="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    Click="Back_Click"
                    CornerRadius="{StaticResource RadiusMD}">
                    <FontIcon FontSize="14" Glyph="&#xE76B;" />
                </Button>
                <StackPanel>
                    <TextBlock
                        FontSize="{StaticResource FontSize2XL}"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" />
                    <TextBlock
                        FontSize="{StaticResource FontSizeMD}"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Fill in the product details below" />
                </StackPanel>
            </StackPanel>

            <!--  Error Message Box  -->
            <controls:AlertBanner Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Type="Error" />

            <!--  Success message box  -->
            <controls:AlertBanner Message="{x:Bind ViewModel.SuccessMessage, Mode=OneWay}" Type="Success" />

            <!--  Basic Information  -->
            <Border
                Padding="24"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLG}">
                <StackPanel Spacing="20">
                    <TextBlock
                        FontSize="{StaticResource FontSizeLG}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Basic Information" />
                    <controls:AppTextBox
                        Label="Product Name *"
                        Placeholder="Enter product name"
                        Text="{x:Bind ViewModel.ProductName, Mode=TwoWay}" />
                    <controls:AppTextBox
                        IsMultiline="True"
                        Label="Description"
                        Placeholder="Describe the product..."
                        Text="{x:Bind ViewModel.Description, Mode=TwoWay}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Category" />
                            <ComboBox
                                Height="44"
                                HorizontalAlignment="Stretch"
                                CornerRadius="{StaticResource RadiusMD}"
                                ItemsSource="{x:Bind ViewModel.Categories}"
                                PlaceholderText="Select category"
                                SelectedItem="{x:Bind ViewModel.Category, Mode=TwoWay}" />
                        </StackPanel>
                        <controls:AppTextBox
                            Grid.Column="1"
                            Label="SKU"
                            Placeholder="e.g. SKU-001"
                            Text="{x:Bind ViewModel.Sku, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Pricing  -->
            <Border
                Padding="24"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLG}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontSize="{StaticResource FontSizeLG}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Pricing" />
                    </StackPanel>

                    <controls:AppTextBox
                        Label="Price (₹) *"
                        Placeholder="e.g. 1500.00"
                        Text="{x:Bind ViewModel.PriceText, Mode=TwoWay}" />
                    <Border
                        Padding="14,10"
                        Background="#F0F9FF"
                        BorderBrush="#BAE6FD"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMD}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontSize="14"
                                Foreground="#0369A1"
                                Glyph="&#xE946;" />
                            <TextBlock
                                FontSize="12"
                                Foreground="#0369A1"
                                TextWrapping="Wrap">
                                <Run Text="Discounts are automatically calculated in the database." />
                                <Run Text="Rules: ₹1001-5000 = 10%, ₹5000+ = 20%" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!--  Inventory  -->
            <Border
                Padding="24"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLG}">
                <StackPanel Spacing="20">
                    <TextBlock
                        FontSize="{StaticResource FontSizeLG}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Inventory" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <controls:AppTextBox
                            Grid.Column="0"
                            Label="Stock"
                            Placeholder="Units in stock"
                            Text="{x:Bind ViewModel.StockText, Mode=TwoWay}" />
                        <controls:AppTextBox
                            Grid.Column="1"
                            Label="Quantity per Unit"
                            Placeholder="e.g. 1"
                            Text="{x:Bind ViewModel.QuantityText, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>



            <!--  Product Image  -->
            <Border
                Padding="24"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusLG}">
                <StackPanel Spacing="16">
                    <TextBlock
                        FontSize="{StaticResource FontSizeLG}"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="Product Image" />

                    <!--  Preview Image  -->
                    <Border
                        Width="160"
                        Height="160"
                        HorizontalAlignment="Left"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMD}">
                        <Grid>
                            <!--  Placeholder icon shown when no image  -->
                            <FontIcon
                                FontSize="48"
                                Foreground="{StaticResource TextMutedBrush}"
                                Glyph="&#xEB9F;"
                                Visibility="{x:Bind ViewModel.HasImage, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                            <!--  Actual image preview  -->
                            <Image
                                x:Name="ProductImagePreview"
                                Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}"
                                Stretch="UniformToFill"
                                Visibility="{x:Bind ViewModel.HasImage, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <controls:AppButton
                            Click="PickImage_Click"
                            IconGlyph="&#xEB9F;"
                            Label="Choose Image"
                            Variant="Secondary" />
                        <controls:AppButton
                            Click="RemoveImage_Click"
                            IconGlyph="&#xE74D;"
                            Label="Remove"
                            Variant="Secondary"
                            Visibility="{x:Bind ViewModel.HasImage, Converter={StaticResource BoolToVis}, Mode=OneWay}" />
                    </StackPanel>

                    <TextBlock
                        FontSize="12"
                        Foreground="{StaticResource TextMutedBrush}"
                        Text="Supported formats: JPG, PNG, GIF, BMP · Max 5 MB" />
                </StackPanel>
            </Border>



            <!--  Actions  -->
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="12">
                <controls:AppButton
                    Click="Back_Click"
                    Label="Cancel"
                    Variant="Secondary" />
                <controls:AppButton
                    Command="{x:Bind ViewModel.SaveCommand}"
                    IconGlyph="&#xE74E;"
                    IsLoading="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Label="Save Product" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
