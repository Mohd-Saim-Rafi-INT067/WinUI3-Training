<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Assignment_Product_Manager.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Assignment_Product_Manager.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:converters="using:Assignment_Product_Manager.Core.Converters"
    xmlns:controls="using:Assignment_Product_Manager.Controls">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToVis" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="800" />
        </Grid.ColumnDefinitions>

        <!--  Left brand panel  -->
        <Grid Grid.Column="0" Background="{StaticResource BrandPrimaryBrush}">
            <StackPanel
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="16">
                <FontIcon
                FontSize="64"
                Foreground="White"
                Glyph="&#xE7BF;" />
                <TextBlock
                FontSize="28"
                FontWeight="Bold"
                Foreground="White"
                Text="Smart Product"
                TextAlignment="Center" />
                <TextBlock
                Margin="0,-12,0,0"
                FontSize="28"
                FontWeight="Bold"
                Foreground="White"
                Text="Manager"
                TextAlignment="Center" />
                <TextBlock
                FontSize="14"
                Foreground="#BFDBFE"
                Text="Manage your inventory with ease."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!--  Login card  -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel
            Padding="48,60"
            VerticalAlignment="Center"
            Spacing="24">

                <!--  Header  -->
                <StackPanel Spacing="6">
                    <TextBlock
                    FontSize="{StaticResource FontSize3XL}"
                    FontWeight="Bold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="Welcome Back!" />
                    <TextBlock
                    FontSize="{StaticResource FontSizeMD}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Sign in to your account" />
                </StackPanel>

                <!--  Error banner  -->
                <Border
                Padding="14,10"
                Background="#FEF2F2"
                BorderBrush="#FECACA"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMD}"
                Visibility="{x:Bind ViewModel.ErrorMessage, Converter={StaticResource NullToVis}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                        FontSize="14"
                        Foreground="{StaticResource BrandDangerBrush}"
                        Glyph="&#xE783;" />
                        <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource BrandDangerBrush}"
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  username  -->
                <controls:AppTextBox
                x:Name="UsernameBox"
                Label="Username"
                Placeholder="Enter your username"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Text="{x:Bind ViewModel.Username, Mode=TwoWay}" />

                <controls:AppPasswordBox
                x:Name="PasswordBox"
                Label="Password"
                VerticalAlignment="Center"
                Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                Placeholder="Enter your password" />

                <!--  Login button  -->
                <controls:AppButton
                Command="{x:Bind ViewModel.LoginCommand}"
                IconGlyph="&#xE8EC;"
                IsLoading="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Label="Sign In" />

                <!--  Divider  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Rectangle
                    Grid.Column="0"
                    Height="1"
                    VerticalAlignment="Center"
                    Fill="{StaticResource BorderBrush}" />
                    <TextBlock
                    Grid.Column="1"
                    FontSize="12"
                    Foreground="{StaticResource TextMutedBrush}"
                    Text="   OR   " />
                    <Rectangle
                    Grid.Column="2"
                    Height="1"
                    VerticalAlignment="Center"
                    Fill="{StaticResource BorderBrush}" />
                </Grid>

                <!--  Sign up redirect  -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock
                    FontSize="16"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Don't have an account?"
                    VerticalAlignment="Center"/>

                    <HyperlinkButton
                    Content="Create Account"
                    Command="{x:Bind ViewModel.GoToSignUpCommand}"
                    Padding="0"
                    Margin="6,0,0,0"
                    FontSize="14"
                    VerticalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
