<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NavigationApp.Pages.DashboardHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NavigationApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <StackPanel Spacing="12">
            <TextBlock
                FontSize="28"
                FontWeight="Bold"
                Text="Dashboard" />
            <TextBlock x:Name="WelcomeText" FontSize="16" />
            <TextBlock FontWeight="SemiBold" Text="Select Category: " />
            <ComboBox
                x:Name="CategoryCombo"
                Width="240"
                SelectionChanged="CategoryCombo_SelectionChanged">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Important" />
                <ComboBoxItem Content="Normal" />
            </ComboBox>
            <TextBlock FontWeight="SemiBold" Text="Items:" />
            <ListView x:Name="ItemsListView" Height="250" />
            <TextBlock
                x:Name="StatusText"
                FontSize="12"
                Foreground="Gray" />
        </StackPanel>
    </Grid>
</Page>
