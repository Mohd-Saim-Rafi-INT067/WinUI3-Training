<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NavigationApp.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NavigationApp.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="LabelTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,5,0,5" />
            </Style>

            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="CustomTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#FFFAFAFA" />
                <Setter Property="BorderBrush" Value="#FFD0D0D0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,8,12,8" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="ErrorStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="Red" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="1"
            Width="400"
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="black"
            BorderThickness="1"
            CornerRadius="4"
            Orientation="Vertical"
            Spacing="20">

            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="LOGIN"
                TextAlignment="Center" />

            <!--  Email  -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="Email" />
                <TextBox
                    x:Name="EmailTextBox"
                    Height="40"
                    PlaceholderText="Enter your Email"
                    Style="{StaticResource CustomTextBoxStyle}" />
                <TextBlock
                    x:Name="EmailError"
                    Style="{StaticResource ErrorStyle}"
                    Text=""
                    Visibility="Collapsed" />
            </StackPanel>

            <!--  Password  -->
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="Password" />
                <PasswordBox
                    x:Name="PasswordBox"
                    Height="40"
                    Padding="12,8,12,8"
                    Background="#FFFAFAFA"
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="1"
                    CornerRadius="4"
                    PlaceholderText="Enter your password" />
                <TextBlock
                    x:Name="PasswordError"
                    Style="{StaticResource ErrorStyle}"
                    Text=""
                    Visibility="Collapsed" />
            </StackPanel>

            <Button
                x:Name="LoginButton"
                Height="40"
                HorizontalAlignment="Stretch"
                Click="LoginButton_Click"
                Content="Login"
                FontSize="16"
                Foreground="White"
                Style="{StaticResource AccentButtonStyle}" />

            <TextBlock
                x:Name="LoginError"
                FontSize="12"
                Foreground="Red"
                TextAlignment="Center"
                Visibility="Collapsed" />


            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5">
                <TextBlock Text="Don't Have an Account?" />
                <HyperlinkButton
                    Padding="0"
                    Click="SignUpLink_Click"
                    Content="SignUp" />

            </StackPanel>

        </StackPanel>
    </Grid>
</Page>
