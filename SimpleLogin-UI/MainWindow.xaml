<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SimpleLogin_UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SimpleLogin_UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SimpleLogin-UI"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Name="LabelTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,5,0,5" />
            </Style>

            <Style x:Name="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,20" />
            </Style>

            <Style x:Name="CustomTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#FFFAFAFA" />
                <Setter Property="Foreground" Value="#FF333333" />
                <Setter Property="BorderBrush" Value="#FFD0D0D0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,8,12,8" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Name="ErrorMessageStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="Red" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Login Panel  -->
        <StackPanel
            Grid.Row="1"
            Width="400"
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1"
            CornerRadius="4"
            Orientation="Vertical"
            Spacing="20">

            <!--  Title  -->
            <TextBlock
                FontSize="32"
                FontWeight="Bold"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="LOGIN"
                TextAlignment="Center" />

            <!--  Username Section  -->
            <StackPanel Orientation="Vertical" Spacing="5">

                <!--  Username Label  -->
                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="Username" />

                <!--  Username TextBox  -->
                <TextBox
                    x:Name="UsernameTextBox"
                    Height="40"
                    PlaceholderText="Enter your Username"
                    Style="{StaticResource CustomTextBoxStyle}" />

                <!--  Username Error Message  -->
                <TextBlock
                    x:Name="UsernameErrorMessage"
                    Style="{StaticResource ErrorMessageStyle}"
                    Text=""
                    Visibility="Collapsed" />

            </StackPanel>

            <!--  Password Section  -->
            <StackPanel Orientation="Vertical" Spacing="5">

                <!--  Password Label  -->
                <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="Password" />

                <!--  Password TextBox  -->
                <PasswordBox
                    x:Name="PasswordBox"
                    Height="40"
                    Padding="12,8,12,8"
                    Background="#FFFAFAFA"
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="1"
                    CornerRadius="4"
                    PlaceholderText="Enter Your Password" />

                <!--  Password Error Message  -->
                <TextBlock
                    x:Name="PasswordErrorMessage"
                    Style="{StaticResource ErrorMessageStyle}"
                    Text=""
                    Visibility="Collapsed" />

            </StackPanel>


            <!--  Login Button  -->
            <Button
                x:Name="LoginButton"
                Height="40"
                HorizontalAlignment="Stretch"
                Click="LoginButton_Click"
                Content="Login"
                FontSize="16"
                Foreground="AntiqueWhite"
                Style="{StaticResource AccentButtonStyle}" />

            <!--  Signup Link  -->
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="5">
                <TextBlock Text="Don't Have an Account?" />
                <HyperlinkButton Padding="0" Content="SignUp" />

            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
