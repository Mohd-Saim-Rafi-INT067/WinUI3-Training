<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="NavigationAppWithMVVM.Views.DashboardHomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NavigationAppWithMVVM.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20">
        <StackPanel Spacing="12">
            <TextBlock
                FontSize="28"
                FontWeight="Bold"
                Text="Dashboard" />
            <TextBlock FontSize="16" Text="{Binding WelcomeText}" />
            <TextBlock FontWeight="SemiBold" Text="Select Category: " />
            <ComboBox
                x:Name="CategoryCombo"
                Width="240"
                SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Important" />
                <ComboBoxItem Content="Normal" />
            </ComboBox>
            <TextBlock FontWeight="SemiBold" Text="Items:" />
            <ListView
                x:Name="ItemsListView"
                Height="250"
                ItemsSource="{Binding Items}" />
            <TextBlock
                FontSize="12"
                Foreground="Gray"
                Text="{Binding StatusText}" />
        </StackPanel>
    </Grid>
</Page>
